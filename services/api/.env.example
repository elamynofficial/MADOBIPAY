PORT=4000

# MADOBIPAY Supabase project (ref fetfdndpqzkmhrgxclhu)
SUPABASE_URL=https://fetfdndpqzkmhrgxclhu.supabase.co
# Project Settings → API → anon public (never commit the real value)
SUPABASE_ANON_KEY=
# Project Settings → API → service_role (server only, never put in the Expo app)
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → URI. Replace [YOUR-PASSWORD] with the database password.
# Use port 5432 (direct) for migrate/seed. Add ?sslmode=require.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.fetfdndpqzkmhrgxclhu.supabase.co:5432/postgres?sslmode=require

# Only when DATABASE_URL is empty. Local in-process Postgres; not production.
PG_EMBEDDED=false

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
DEMO_OTP=123456

# Paystack Dashboard → Settings → API Keys (test mode). Never commit real keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

